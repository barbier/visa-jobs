<div class="d-flex justify-content-between align-items-center job__header">
  <h2><%= @job.title %></h2>
  <div class="d-flex align-items-center job__action-buttons">
    <%= link_to "Back", :back, :class => "btn btn-primary" %>
    <%= link_to "Edit", edit_job_path, :class => "btn btn-primary mx-2" if authenticated? %>
    <%= button_to "Delete", @job, :class => "btn btn-danger", method: :delete, data: { turbo_confirm: "Are you sure?" } if authenticated? %>
  </div>
</div>
<% if !@job.salary.nil? %>
  <p>€<%= @job.salary%></p>
<% end %>
<pre class="job__description"><%= @job.description%></pre>